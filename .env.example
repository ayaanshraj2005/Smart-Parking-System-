# Active Profile (dev or prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port (automatically assigned on platforms like Railway)
PORT=8080

# Database Configuration (Full JDBC URL for MySQL in production)
DB_URL=jdbc:mysql://localhost:3306/parknow_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# JWT Authentication Parameters
JWT_SECRET=your_secure_64_character_hex_jwt_secret_key
JWT_EXPIRATION=86400000

# Backend CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://your-app.vercel.app

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api
